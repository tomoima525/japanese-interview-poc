# Copy to .env and fill in. Only the keys for the providers you use are needed.

# --- LLM (required) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# --- Speech-to-text (Japanese) ---
# auto = first available of: soniox → elevenlabs → deepgram
STT_PROVIDER=auto
SONIOX_API_KEY=            # recommended for Japanese (stt-rt-v6)
DEEPGRAM_API_KEY=          # nova-3 (Deepgram's newest Japanese build), language=ja
# ELEVENLABS_API_KEY=      # Scribe v2 realtime (also used for TTS below)
# SONIOX_STT_MODEL=stt-rt-v6
# DEEPGRAM_STT_MODEL=nova-3              # or flux-general-multi (Flux Multilingual)
# ELEVENLABS_STT_MODEL=scribe_v2_realtime

# --- Text-to-speech (Japanese) ---
# auto = first available of: cartesia → elevenlabs → soniox
TTS_PROVIDER=auto
CARTESIA_API_KEY=          # recommended (sonic-3.6, native Japanese voices)
# CARTESIA_TTS_MODEL=sonic-3.6
# CARTESIA_VOICE_ID=2b568345-1d48-4047-b25f-7baccf842eb0   # Japanese Woman Conversational
# Alternatives: e8a863c6-22c7-4671-86ca-91cacffc038d (Japanese Male Conversational)
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=
# SONIOX_TTS_MODEL=tts-rt-v2
# SONIOX_VOICE=

# --- Turn-taking ---
# Silence (s) before Smart Turn decides the candidate is done. 0.8 avoids
# cutting in between sentences of a long Japanese answer; 0.2 = Pipecat default.
# VAD_STOP_SECS=0.8
